<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunktrionApp.ViewModels"
             xmlns:views="using:LunktrionApp.Views"
             x:Class="LunktrionApp.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>

        <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
            <views:LoadingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NavigationPanelViewModel}">
            <views:NavigationPanel/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActiveDevicesListViewModel}">
            <views:ActiveDevicesList/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NotificationViewModel}">
            <views:NotificationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <views:DeviceView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DevicesListViewModel}">
            <views:DevicesListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeviceCommandConsoleViewModel}">
            <views:DeviceCommandConsole />
        </DataTemplate>

    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />     
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LunktrionApp/Styles/Buttons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>