<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="1000"
             x:Class="LunktrionApp.Views.DeviceCommandConsole"
             x:DataType="vm:DeviceCommandConsoleViewModel">

    <Design.DataContext>
        <vm:DeviceCommandConsoleViewModel />
    </Design.DataContext>

    <Border Margin="12.5, 25, 25, 25" Background="#241C16" CornerRadius="16">
        <Grid ColumnDefinitions="30*, 70*">
            <ContentControl Grid.Column="0" Content="{Binding DevicesListViewModel}" />
            <Grid Grid.Column="1" RowDefinitions="90*, 10*" RowSpacing="12" Margin="12.5, 25, 25, 25">
                <Border Grid.Row="0" Background="#1A1410" CornerRadius="16">
                    <ListBox IsVisible="{Binding IsDeviceSelected}" 
                             Background="Transparent" 
                             ItemsSource="{Binding SelectedDeviceLogs}" 
                             Margin="12.5">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding">0</Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="16*, 84*" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0" Foreground="#A8998D" Text="{Binding Timestamp, StringFormat='[{0}]:'}" />
                                    <TextBlock Grid.Column="1" Foreground="#F5E6D8" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border IsVisible="{Binding IsDeviceSelected}" Grid.Row="1" Background="#1A1410" CornerRadius="16">
                    <Border Margin="12.5, 0, 12.5, 0">
                        <TextBox Theme="{StaticResource BrownTextBox}"
                                 Text="{Binding CommandInput}"
                                 PlaceholderText="Введите команду"
                                 Padding="12.5"
                                 CornerRadius="16"
                                 VerticalAlignment="Center">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CreateCommandCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
