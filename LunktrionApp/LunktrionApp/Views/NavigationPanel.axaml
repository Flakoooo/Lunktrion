<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunktrionApp.Views.NavigationPanel"
             x:DataType="vm:NavigationPanelViewModel">

    <Design.DataContext>
        <vm:NavigationPanelViewModel />
    </Design.DataContext>

    <Border Margin="25, 25, 12.5, 12.5" Background="#241C16" CornerRadius="16" Padding="16">
        <StackPanel Spacing="16">
            <Button Theme="{StaticResource OrangeButton}"
                    Content="Текущее устройство"
                    Command="{Binding NavigateToCurrentDeviceCommandCommand}" />
            <Button Theme="{StaticResource OrangeButton}"
                    Content="Все устройства"
                    Command="{Binding NavigateToAllDevicesCommandCommand}"/>
            <Button Theme="{StaticResource OrangeButton}"
                    Content="Консоль"
                    Command="{Binding NavigateToCommandConsoleAsync}"/>
        </StackPanel>
    </Border>
</UserControl>
