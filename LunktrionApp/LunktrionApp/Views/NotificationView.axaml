<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:LunktrionApp.Converters"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="LunktrionApp.Views.NotificationView"
             x:DataType="vm:NotificationViewModel"
             IsHitTestVisible="False"
             Background="Transparent">

    <UserControl.Resources>
        <conv:NotificationTypeToBrushConverter x:Key="NotificationTypeToBrushConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:NotificationViewModel />
    </Design.DataContext>

    <ListBox x:Name="NotificationsList"
             Background="Transparent" 
             ItemsSource="{Binding Notifications}" 
             HorizontalAlignment="Right" 
             VerticalAlignment="Bottom">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0,0,12,12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Right"/> 
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="{Binding Type, Converter={StaticResource NotificationTypeToBrushConverter}}"
                        Padding="12" CornerRadius="8">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" 
                                    FontSize="32" 
                                    Foreground="#1A1410" 
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap"/>
                        <Button Grid.Column="1" FontSize="40" Background="Transparent">
                            <ic:SymbolIcon Symbol="Dismiss" 
                                            FontSize="28" 
                                            Foreground="#1A1410"/>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>
