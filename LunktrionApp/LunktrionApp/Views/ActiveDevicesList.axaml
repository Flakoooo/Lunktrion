<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="756"
             x:Class="LunktrionApp.Views.ActiveDevicesList"
             x:DataType="vm:ActiveDevicesListViewModel">

    <Design.DataContext>
        <vm:ActiveDevicesListViewModel />
    </Design.DataContext>

    <Border Margin="25, 12.5, 12.5, 25" Background="#241C16" CornerRadius="16" ClipToBounds="True">
        <Grid RowDefinitions="11*, 89*" RowSpacing="12.5">
            <Button Grid.Row="0"
                    Theme="{StaticResource OrangeButton}"
                    Content="Активные устройства"
                    Margin="16, 16, 16, 0"/>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Devices}" 
                     Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="BorderBrush" Value="#B85C1E"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="Padding" Value="0"/> 
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="ListBoxItem:nth-last-child(1)">
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    
                    <Style Selector="Button.row-button"> 
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>

                    <Style Selector="Button.row-button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.row-button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="row-button"
                                Command="{Binding $parent[ListBox].DataContext.NavigateToDeviceCommandAsync}"
                                CommandParameter="{Binding}">
                            
                            <StackPanel Margin="16, 8, 8, 8" Spacing="12">
                                <TextBlock FontSize="24" Text="{Binding DeviceName}" Foreground="#F5E6D8" Margin="0, 4, 0, 0" />
                                <TextBlock FontSize="24" Text="{Binding OperatingSystemName}" Foreground="#A8998D" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
