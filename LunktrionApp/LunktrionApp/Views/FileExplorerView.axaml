<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="1000"
             x:Class="LunktrionApp.Views.FileExplorerView"
             x:DataType="vm:FileExplorerViewModel">

    <Design.DataContext>
        <vm:FileExplorerViewModel />
    </Design.DataContext>

    <Border Margin="12.5, 25, 25, 25" Background="#241C16" CornerRadius="16">
        <Grid ColumnDefinitions="30*, 70*">
            <ContentControl Grid.Column="0" Content="{Binding DevicesListViewModel}" />
            <Border Grid.Column="1" Background="#1A1410" CornerRadius="16"  Margin="12.5, 25, 25, 25">
                <!-- 
                    думаю в черном поле будут только сами файлы,
                    а над ними, на коричневом фоне, где то на 1/3 от высоты
                    будут показываться имя выбранного устройства, путь до папки и может что то ещё
                    также, начинать просмотр файлов надо с корневы дисков. будет выбор сначала диска в черном поле
                -->
            </Border>
        </Grid>
    </Border>
</UserControl>
