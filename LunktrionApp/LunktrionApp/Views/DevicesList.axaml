<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunktrionApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="1000"
             x:Class="LunktrionApp.Views.DevicesList"
             x:DataType="vm:DevicesListViewModel">

    <Design.DataContext>
        <vm:DevicesListViewModel />
    </Design.DataContext>

    <Border Background="#1A1410" CornerRadius="16" Margin="25, 25, 12.5, 25">
        <ListBox Background="Transparent" 
                    ItemsSource="{Binding Devices}" 
                    SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                    Margin="12.5">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding">0, 0, 0, 12.5</Setter>
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="ListBoxItem Button > Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>

                <Style Selector="ListBoxItem:selected Button > Border">
                    <Setter Property="BorderBrush" Value="#B85C1E" />
                </Style>

                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
    
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="Button.row-button"> 
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>

                <Style Selector="Button.row-button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Button.row-button:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Classes="row-button"
                            Command="{Binding $parent[ListBox].DataContext.SelectDevice}"
                            CommandParameter="{Binding}">
                        <Border Background="#241C16" 
                                CornerRadius="16" 
                                Padding="16, 8, 8, 8"
                                BorderThickness="2">
                            <StackPanel Spacing="12">
                                <TextBlock FontSize="24" Text="{Binding DeviceName}" Foreground="#F5E6D8" Margin="0, 4, 0, 0" />
                                <TextBlock FontSize="24" Text="{Binding OperatingSystemName}" Foreground="#A8998D" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
