<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Components\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.337" />
    <PackageReference Include="Hardware.Info" Version="110.0.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\ActiveDevicesList.axaml.cs">
      <DependentUpon>ActiveDevicesList.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\NavigationPanel.axaml.cs">
      <DependentUpon>NavigationPanel.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\DevicesListView.axaml.cs">
      <DependentUpon>DevicesListView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LunktrionShared\LunktrionShared\LunktrionShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include=".env" />
  </ItemGroup>

  <Target Name="GenerateApiConfig" BeforeTargets="BeforeCompile;CoreCompile">
    <ReadLinesFromFile File=".env" Condition="Exists('.env')">
      <Output TaskParameter="Lines" ItemName="EnvLine" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <RawEnvLine>API_BASE_URL=http://localhost:50000</RawEnvLine>
      <RawEnvLine Condition="Exists('.env')">@(EnvLine)</RawEnvLine>
      <ConfiguredApiUrl>$(RawEnvLine.Substring(13))</ConfiguredApiUrl>
    </PropertyGroup>

    <WriteLinesToFile File="$(IntermediateOutputPath)BuildConfig.g.cs" Lines="namespace LunktrionApp%3B public static class BuildConfig { public const string ApiBaseUrl = %22$(ConfiguredApiUrl)%22%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildConfig.g.cs" />
    </ItemGroup>
  </Target>
  
</Project>
